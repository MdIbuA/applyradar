# Copy to .env (gitignored). Generate the secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=paste-at-least-32-random-characters-here
JWT_TTL_HOURS=24

APP_TIMEZONE=Asia/Kolkata
# Daily digest PDF: "minute hour" in APP_TIMEZONE (07:30 by default)
DIGEST_CRON=30 7
SCHEDULER_ENABLED=true

# AI extraction: any OpenAI-compatible API. Defaults = local Ollama, free, no key.
LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=30
# No model installed? LLM_STUB=1 returns a fixed answer so everything else still works.
LLM_STUB=0
LLM_ENABLED=true
